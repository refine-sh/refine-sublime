              "appearance": {
                "highlight": { "style": "underline", "grammarColor": "#FF2D55", "fluencyColor": "#007AFF" },
                "diff": { "additionColor": "#34C759", "deletionColor": "#FF3B30", "showHiddenWhitespace": true }
              },
              "interaction": {
                "automaticChecksEnabled": true,
                "quickApply": { "enabled": true, "applyKey": "tab", "dismissKey": "escape", "activationStyle": "showTipAndHighlight" }
              }
            }
          }
        } },
        { "direction": "client", "close": true }
      ]
    },
    {
      "expectedOutcome": "protocolError",
      "steps": [
        { "direction": "client", "messageRef": "hello" },
        { "direction": "server", "messageRef": "welcome" },
        { "direction": "server", "invalid": "schema", "message": {
          "type": "event", "sequence": 1, "epoch": "${serverEpoch}",
          "event": {
            "type": "presentationContentReplaced", "checkId": "check",
            "content": {
              "documentRevision": "revision", "status": "complete", "coverage": "full",
              "suggestions": [{
                "id": "suggestion", "sourceId": "document", "kind": "grammar",
                "attribution": { "languageDisplayName": "English", "textDirection": "ltr", "checkModelDisplayName": "Model" },
                "activationRange": { "location": 0, "length": 1 },
                "highlightRanges": [{ "location": 0, "length": 1 }],
                "diff": [{ "kind": "unchanged", "text": "a" }],
                "availableActions": ["apply", "apply"]
              }],
              "appearance": {
                "highlight": { "style": "underline", "grammarColor": "#FF2D55", "fluencyColor": "#007AFF" },
                "diff": { "additionColor": "#34C759", "deletionColor": "#FF3B30", "showHiddenWhitespace": true }
              },
              "interaction": {
                "automaticChecksEnabled": true,
                "quickApply": { "enabled": true, "applyKey": "tab", "dismissKey": "escape", "activationStyle": "showTipAndHighlight" }
              }
            }
          }
        } },
        { "direction": "client", "close": true }
      ]
    },
    {
      "expectedOutcome": "protocolError",
      "steps": [
        { "direction": "client", "messageRef": "hello" },
        { "direction": "server", "messageRef": "welcome" },
        { "direction": "server", "invalid": "schema", "message": {
          "type": "event", "sequence": 1, "epoch": "${serverEpoch}",
          "event": {
            "type": "presentationContentReplaced", "checkId": "check",
            "content": {
              "documentRevision": "revision", "status": "complete", "coverage": "full",
              "suggestions": [{
                "id": "suggestion", "sourceId": "document", "kind": "grammar",
                "attribution": { "languageDisplayName": "", "textDirection": "ltr", "checkModelDisplayName": "Model" },
                "activationRange": { "location": 0, "length": 1 },
                "highlightRanges": [], "diff": [], "availableActions": ["apply"]
              }],
              "appearance": {
                "highlight": { "style": "underline", "grammarColor": "#FF2D55", "fluencyColor": "#007AFF" },
                "diff": { "additionColor": "#34C759", "deletionColor": "#FF3B30", "showHiddenWhitespace": true }
              },
              "interaction": {
                "automaticChecksEnabled": true,
                "quickApply": { "enabled": true, "applyKey": "tab", "dismissKey": "escape", "activationStyle": "showTipAndHighlight" }
              }
            }
          }
        } },
        { "direction": "client", "close": true }
      ]
    },
    {
      "expectedOutcome": "protocolError",
      "steps": [
        { "direction": "client", "messageRef": "hello" },
        { "direction": "server", "messageRef": "welcome" },
        { "direction": "server", "invalid": "eventSemantics", "message": {
          "type": "event", "sequence": 1, "epoch": "${serverEpoch}",
          "event": {
            "type": "applyRequested", "actionId": "action", "transactionId": "transaction",
            "request": {
              "expectedRevision": "revision", "sourceId": "document",
              "edits": [{ "range": { "location": 0, "length": 0 }, "expectedText": "", "replacement": "" }]
            }
          }
        } },
        { "direction": "client", "close": true }
      ]
    },
    {
      "expectedOutcome": "protocolError",
      "steps": [
        { "direction": "client", "messageRef": "hello" },
        { "direction": "server", "messageRef": "welcome" },
        { "direction": "server", "invalid": "eventSemantics", "message": {
          "type": "event", "sequence": 1, "epoch": "${serverEpoch}",
          "event": {
            "type": "applyRequested", "actionId": "action", "transactionId": "transaction",
            "request": {
              "expectedRevision": "revision", "sourceId": "document",
              "edits": [{
                "range": { "location": 9007199254740991, "length": 1 },
                "expectedText": "a", "replacement": "b"
